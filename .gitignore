# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints & runtime
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.ipython/

# Large preprocessed numpy array caches (regenerated by running main.py)
outputs/processed/*.npy

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Kaggle / Secrets / API tokens
kaggle.json
*.env
*.pem
*.key

# Logs & temporary files
*.log
scratch/
tmp/
